<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="payment_provider_form_raiffeisen" model="ir.ui.view">
        <field name="name">payment.provider.form.raiffeisen</field>
        <field name="model">payment.provider</field>
        <field name="inherit_id" ref="payment.payment_provider_form"/>
        <field name="arch" type="xml">
            <group name="provider_credentials" position="inside">
                <group invisible="code != 'raiffeisen'"
                       name="raiffeisen_credentials"
                       colspan="2"
                       string="Raiffeisen RaiAccept">
                    <!-- Production credentials: shown only when live -->
                    <group string="Production Credentials" colspan="2"
                           invisible="not is_live">
                        <field name="raiffeisen_api_username"
                               string="Username"
                               required="is_live"
                               copy="False"/>
                        <field name="raiffeisen_api_password"
                               string="Password"
                               password="True"
                               required="is_live"
                               copy="False"/>
                    </group>
                    <!-- Sandbox credentials: shown only in test mode -->
                    <group string="Sandbox Credentials" colspan="2"
                           invisible="is_live">
                        <field name="raiffeisen_sandbox_username"
                               string="Sandbox Username"
                               copy="False"/>
                        <field name="raiffeisen_sandbox_password"
                               string="Sandbox Password"
                               password="True"
                               copy="False"/>
                    </group>
                    <!-- Currency settings: always visible -->
                    <group string="Currency Settings" colspan="2">
                        <field name="raiffeisen_gateway_currency"/>
                        <field name="raiffeisen_currency_rate"/>
                    </group>
                </group>
            </group>
        </field>
    </record>

</odoo>
